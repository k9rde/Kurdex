<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingLeft="9dp"
    android:paddingTop="8dp"
    android:paddingRight="9dp"
    android:paddingBottom="8dp">

    <!-- Top-Center Frosted Glass Digital Countdown Hero Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.28"
        android:background="@drawable/widget_hero_glass_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp">

        <!-- Top Row: City (Right) • Countdown Label Pill (Top-Center) • Next Adhan Time (Left) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_city_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="الموصل"
                android:textColor="#EBF5EE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_prayer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/widget_countdown_label_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingLeft="10dp"
                android:paddingTop="3dp"
                android:paddingRight="10dp"
                android:paddingBottom="3dp"
                android:text="المتبقي للعصر"
                android:textColor="#FCE588"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_prayer_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="03:25 م"
                android:textColor="#FCE588"
                android:textDirection="ltr"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Centerpiece: Large Digital Live Countdown Timer (Top Center Focal Point) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <Chronometer
                android:id="@+id/widget_countdown_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textColor="#FFFFFF"
                android:textDirection="ltr"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero Footer Ribbon: Hijri Date (Right) • Live Elapsed ProgressBar (Center) • Daily Completed Badge (Left) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="2 جمادى الآخرة 1448"
                android:textColor="#D9F3E5AB"
                android:textSize="9.5sp" />

            <ProgressBar
                android:id="@+id/widget_prayer_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="55"
                android:progressDrawable="@drawable/widget_progress_bar" />

            <TextView
                android:id="@+id/widget_completed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="تمت 0/5"
                android:textColor="#86EFAC"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Full-Width 6-Card Frosted Glass Prayer Row (Zero Empty Gaps) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1.0"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/widget_tile_fajr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingTop="4dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_fajr_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="الفجر"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="05:10"
                android:textColor="#FFFFFF"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_fajr_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:text="ص"
                android:textColor="#99F3E5AB"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- Sunrise -->
        <LinearLayout
            android:id="@+id/widget_tile_sunrise"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingTop="4dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_sunrise_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="الشروق"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_sunrise_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="06:38"
                android:textColor="#FFFFFF"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_sunrise_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:text="ص"
                android:textColor="#99F3E5AB"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/widget_tile_dhuhr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingTop="4dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_dhuhr_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="الظهر"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="12:05"
                android:textColor="#FFFFFF"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_dhuhr_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:text="م"
                android:textColor="#99F3E5AB"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/widget_tile_asr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_active_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingTop="4dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_asr_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="العصر"
                android:textColor="#FFE89E"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="03:25"
                android:textColor="#FFFFFF"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_asr_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:text="م"
                android:textColor="#FFE89E"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/widget_tile_maghrib"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingTop="4dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_maghrib_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="المغرب"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="05:45"
                android:textColor="#FFFFFF"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_maghrib_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:text="م"
                android:textColor="#99F3E5AB"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/widget_tile_isha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="2dp"
            android:paddingTop="4dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_isha_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="العشاء"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="07:05"
                android:textColor="#FFFFFF"
                android:textDirection="ltr"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_isha_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:text="م"
                android:textColor="#99F3E5AB"
                android:textSize="8.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
